  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "",
          "// Read current counts from collection variables (default to 0 if not set)",
          "let successRequestCount = parseInt(pm.collectionVariables.get(\"successRequestCount\")) || 0;",
          "let redirectRequestCount = parseInt(pm.collectionVariables.get(\"redirectRequestCount\")) || 0;",
          "let errorRequestCount = parseInt(pm.collectionVariables.get(\"errorRequestCount\")) || 0;",
          "",
          "const statusCode = pm.response.code;",
          "",
          "// Increment the appropriate counter based on response status code range",
          "if (statusCode >= 200 && statusCode < 300) {",
          "    successRequestCount++;",
          "} else if (statusCode >= 300 && statusCode < 400) {",
          "    redirectRequestCount++;",
          "} else if (statusCode >= 400 && statusCode < 600) {",
          "    errorRequestCount++;",
          "}",
          "",
          "// Set the updated values back into collection variables",
          "pm.collectionVariables.set(\"successRequestCount\", successRequestCount);",
          "pm.collectionVariables.set(\"redirectRequestCount\", redirectRequestCount);",
          "pm.collectionVariables.set(\"errorRequestCount\", errorRequestCount);",
          "",
          "// Log current counts via pm.test so they appear in the test results panel",
          "pm.test(`Success (2xx) count: ${successRequestCount}`, function () {",
          "    pm.expect(successRequestCount).to.be.a(\"number\");",
          "});",
          "",
          "pm.test(`Redirect (3xx) count: ${redirectRequestCount}`, function () {",
          "    pm.expect(redirectRequestCount).to.be.a(\"number\");",
          "});",
          "",
          "pm.test(`Error (4xx/5xx) count: ${errorRequestCount}`, function () {",
          "    pm.expect(errorRequestCount).to.be.a(\"number\");",
          "});",
          ""
        ],
        "id": "c2ebb75e-d451-4c4c-86d1-20ab5611afa5"
      }
    }
